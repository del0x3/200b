# Скопируй в .env и заполни. .env в git не коммитим.

# Если не задан, локально используется SQLite (./dev.db). На Render — Postgres.
DATABASE_URL=

# Любая длинная случайная строка. Render Blueprint сгенерит автоматически.
JWT_SECRET=change-me-to-a-long-random-string

# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# production | development
ENV=development
